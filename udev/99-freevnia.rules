# Let the logged-in user talk to the VIA Labs Billboard device of the Philips Evnia 49M2C8900L
# (DDC/CI over USB) and to its Ambiglow LED controller. No group is needed: "uaccess" gives access to whoever is
# logged in at the computer (works on Debian, Arch, ...). Install:
#   sudo cp udev/99-freevnia.rules /etc/udev/rules.d/ && sudo udevadm control --reload
#   sudo udevadm trigger --subsystem-match=usb --attr-match=idVendor=2109
#   sudo udevadm trigger --subsystem-match=usb --attr-match=idVendor=0cf2
SUBSYSTEM=="usb", ATTR{idVendor}=="2109", ATTR{idProduct}=="8884", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0cf2", ATTR{idProduct}=="b20b", MODE="0660", TAG+="uaccess"
